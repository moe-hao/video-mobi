{
  "name": "@app/task",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file ../../.env src/index.ts",
    "build": "rm -rf dist && tsc --noEmit && node esbuild.config.js",
    "start": "node --env-file ../../.env --enable-source-maps dist/index.js",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@lib/common": "workspace:*",
    "@lib/internal": "workspace:*",
    "@lib/middleware": "workspace:*",
    "@lib/repo": "workspace:*",
    "@volcengine/openapi": "^1.36.2",
    "axios": "^1.19.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "facebook-nodejs-business-sdk": "^24.0.1",
    "ioredis": "^5.10.1",
    "mysql2": "^3.22.3",
    "nanoid": "^6.0.1",
    "node-schedule": "^2.1.1",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/facebook-nodejs-business-sdk": "^24.0.0",
    "@types/node": "^20.19.41",
    "@types/node-schedule": "^2.1.8",
    "esbuild": "^0.28.0",
    "tsx": "^4.7.1",
    "typescript": "~6.0.2"
  }
}