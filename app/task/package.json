{
  "name": "@app/task",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "check": "tsc --noEmit",
    "dev": "tsx watch --env-file ../../.env src/index.ts",
    "build": "node esbuild.config.ts",
    "start": "node --env-file ../../.env --enable-source-maps dist/index.js"
  },
  "dependencies": {
    "@lib/common": "workspace:*",
    "@lib/internal": "workspace:*",
    "@lib/middleware": "workspace:*",
    "@lib/repo": "workspace:*",
    "axios": "^1.19.0",
    "date-fns": "^4.4.0",
    "facebook-nodejs-business-sdk": "^24.0.1",
    "nanoid": "^6.0.1",
    "node-schedule": "^2.1.1"
  },
  "devDependencies": {
    "@types/facebook-nodejs-business-sdk": "^24.0.0",
    "@types/node": "^20.19.41",
    "@types/node-schedule": "^2.1.8",
    "esbuild": "^0.28.0",
    "tsx": "^4.7.1",
    "typescript": "~6.0.2"
  }
