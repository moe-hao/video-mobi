{
  "name": "@app/openapi",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "check": "tsc --noEmit",
    "dev": "tsx watch --env-file ../../.env src/index.ts",
    "build": "node esbuild.config.ts",
    "start": "node --env-file ../../.env --enable-source-maps dist/index.js"
  },
  "dependencies": {
    "@app/order": "workspace:*",
    "@lib/common": "workspace:*",
    "@lib/internal": "workspace:*",
    "@lib/middleware": "workspace:*",
    "@lib/repo": "workspace:*",
    "@hono/node-server": "^1.19.14",
    "hono": "^4.12.18"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20.19.41",
    "esbuild": "^0.28.0",
    "tsx": "^4.7.1",
    "typescript": "~6.0.2"
  }
}